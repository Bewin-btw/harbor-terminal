{
  "name": "harbor-terminal",
  "version": "0.2.1",
  "private": true,
  "description": "Persistent terminal workspaces for macOS",
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "node scripts/fix-pty.cjs",
    "test": "node --test test/core.test.cjs test/activity.test.cjs test/conversation.test.cjs test/native-terminal.test.cjs",
    "test:integration": "node --test test/daemon.test.cjs",
    "build:ui": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --loader:.css=css",
    "start": "npm run build:ui && electron .",
    "package": "npm run build:ui && node scripts/package.mjs",
    "test:ui": "npm run build:ui && node scripts/ui-smoke.cjs && node scripts/ui-features.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "author": "Erik Aktaev <151932945+Bewin-btw@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bewin-btw/harbor-terminal.git"
  },
  "homepage": "https://github.com/Bewin-btw/harbor-terminal#readme",
  "bugs": {
    "url": "https://github.com/Bewin-btw/harbor-terminal/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
